# 이 파일을 .env.local 로 복사한 뒤 값을 채우고 서버를 재시작하세요.
# 연결 상태는 앱의 설정 화면 맨 위 "연결 상태" 카드에서 확인할 수 있습니다.

# 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 선택: 텍스트 모델 (기본값 gpt-6-astra)
OPENAI_MODEL=
# 선택: 상세페이지 판매 문구 모델 (기본값 gpt-6-astra · 키가 있으면 문구는 Gemini 대신 이 모델이 씀)
OPENAI_COPY_MODEL=
# 선택: 썸네일 이미지 모델 (기본값 gpt-image-1)
OPENAI_IMAGE_MODEL=

# 대시보드 트렌드·키워드 분석의 추이/고객층: 네이버 데이터랩(쇼핑인사이트)
# 개발자센터 키는 2027-06-30까지 사용 가능, 이후 NAVER API HUB(네이버클라우드) 키로 교체 필요
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 키워드 분석의 월간 검색수·연관 키워드: 네이버 검색광고 > 도구 > API 사용 관리
# https://searchad.naver.com
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 도매 시세(/prices): KAMIS 농산물 가격정보 Open API (무료)
# https://www.kamis.or.kr/customer/reference/openapi_list.do
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 전국 산지 지도(/farm-map): 공공데이터포털 일반 인증키(Decoding). 아래 3개 API에 각각 활용신청 필요 (자동승인)
# GAP 인증정보 https://www.data.go.kr/data/15141807/openapi.do
# 친환경 인증정보 https://www.data.go.kr/data/15141827/openapi.do
# 산지유통센터 표준데이터 https://www.data.go.kr/data/15114142/standard.do
DATA_GO_KR_KEY=

# ── 상세페이지 제작 (/detail-page, 레버페이지) ──
# Gemini 키는 화면(프로필 메뉴 → API 키 설정)에서 등록하는 것이 기본입니다. 여기 값은 화면에 등록한 키가 없을 때만 쓰입니다.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: 문구 모델 (기본값 gemini-2.5-flash) / 이미지 모델 (기본값 gemini-2.5-flash-image)
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
# 선택: 맨 위 움직이는 컷을 무료 영상으로 바꾸기 — Pexels API 키 (무료, 시간당 200회)
# https://www.pexels.com/api/new/
PEXELS_API_KEY=
# 선택: 무료 영상 검색에 Pixabay도 함께 — API 키 (무료, 1분에 100회 · 로그인 후 아래 문서의 key 항목에 표시)
# https://pixabay.com/api/docs/#api_search_videos
PIXABAY_API_KEY=
# 선택: 프로젝트·템플릿·업로드 파일 저장 폴더 (기본값 .data/detail-page)
LEVER_DATA_DIR=

# ── 배포 시 보안 (내 PC에서만 쓰면 비워 두세요) ──
# 설정하면 사이트 전체에 비밀번호 창이 뜹니다. 아이디는 아무거나, 비밀번호는 이 값.
APP_PASSWORD=
# 선택: IP별 AI 호출 한도 (기본 텍스트 10분 60회, 이미지 1시간 40회)
AI_TEXT_LIMIT=
AI_IMAGE_LIMIT=
