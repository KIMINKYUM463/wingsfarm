# 이 파일을 복사해 같은 폴더에 .env 로 저장하고 = 뒤에 키를 붙여넣으세요.
# 루트 .env.local 키도 Next 엔진이 자동으로 넘깁니다 (OPENAI_API_KEY, PEXELS_API_KEY 등).

# fal.ai (AI 장면 영상·BGM 생성, 유료): https://fal.ai/dashboard/keys
FAL_KEY=

# Pexels (무료 스톡 영상): https://www.pexels.com/api/
PEXELS_API_KEY=

# Replicate (fal.ai 실패 시 대체): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# OpenAI (문구 초안·해부·채팅 — FAL 없을 때 사용). 영상 AI 장면은 FAL/Replicate 필요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Gemini 목소리): https://aistudio.google.com/apikey
GEMINI_API_KEY=
